{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "specialist_profile.v1",
  "description": "FP-043/P5: perfil de especialista por categoria de comodo. Declarativo: descreve escopo, fontes, ferramentas permitidas e condicoes de parada. NAO autoriza execucao (execution_authorized e sempre false aqui; a autorizacao vive na capacidade e no fluxo).",
  "type": "object",
  "required": ["schema_version", "room", "aliases", "role", "scope", "owner", "state", "knowledge_room_ids",
               "source_ids", "recipe_ids", "capability_ids", "tool_allowlist", "constraints", "result_types",
               "stop_conditions", "execution_authorized"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "specialist_profile.v1"},
    "room": {"enum": ["living", "bedroom", "kitchen", "bathroom", "service", "balcony", "closet", "home_office", "circulation"]},
    "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "role": {"enum": ["planner", "advisory", "reuse", "validation_only"],
             "description": "planner = tem brain proprio; advisory = so conhecimento; reuse = reaproveita outro comodo; validation_only = so gate"},
    "reuse_of": {"type": ["string", "null"], "description": "comodo cujo brain/joinery e reaproveitado (role=reuse)"},
    "scope": {"type": "string", "minLength": 20},
    "owner": {"type": "string", "pattern": "^tools\\.rooms\\.[a-z_]+$"},
    "state": {"type": "string", "description": "mesmo vocabulario de tools/rooms/manifest.v1.json"},
    "knowledge_room_ids": {"type": "array", "minItems": 1, "items": {"type": "string"},
                           "description": "ids de comodo no catalogo de conhecimento (service = laundry)"},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"},
                   "description": "ids de recipes de comodo no catalogo environment (nao copia o texto)"},
    "recipe_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tool_allowlist": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(python|ruby|mcp):[A-Za-z0-9_./-]+$"},
      "description": "unica lista de ferramentas que este perfil pode pedir; tudo fora dela e recusado"
    },
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 8}},
    "result_types": {"type": "array", "minItems": 1,
                     "items": {"enum": ["advisory_plan", "boxes_plan", "validation_report", "blocked"]}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "execution_authorized": {"const": false}
  }
}
