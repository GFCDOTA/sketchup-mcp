{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FP-051 P1 furniture_goal.v1 — pure advisory capability DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "room",
    "target_ref",
    "target_id",
    "parts",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "furniture_goal.v1"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{3,100}$"
    },
    "room": {
      "enum": [
        "living",
        "bedroom",
        "kitchen",
        "bathroom",
        "service",
        "balcony",
        "closet",
        "home_office",
        "circulation"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 3
    },
    "target_ref": {
      "type": "string",
      "pattern": "^artifacts/reference_lab/targets/[a-zA-Z0-9_./-]+\\.target\\.v1\\.json$"
    },
    "execution_authorized": {
      "const": false
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "binding_id",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{2,80}$"
          },
          "binding_id": {
            "type": "string",
            "pattern": "^bind\\.[a-zA-Z0-9_.-]+$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 80,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{2,80}$"
            }
          }
        }
      }
    }
  }
}
